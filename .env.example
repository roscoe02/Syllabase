# Copy to .env.local and fill in. Never commit real values.

# Public URL of the site (used for calendar subscribe links). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Anthropic (server-only) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only; bypasses RLS. Used for cron jobs (feed refresh) and usage accounting.
SUPABASE_SECRET_KEY=

# UTD Nebula API (server-only) — request a key from UTD Nebula Labs
NEBULA_API_KEY=

# Daily AI budgets in weighted tokens (1,000,000 is about $0.10 on Haiku 5.5). See src/lib/ai/quota.ts
DAILY_TOKEN_BUDGET=1000000
GUEST_DAILY_TOKEN_BUDGET=200000
# All users together, per UTC day
SITE_DAILY_TOKEN_BUDGET=10000000

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token). Generate with: openssl rand -hex 32
CRON_SECRET=

# OAuth sign-in buttons to show, once enabled in Supabase: "google", "azure" or "google,azure". Empty: guest + email only.
NEXT_PUBLIC_AUTH_PROVIDERS=

# Rate My Professors aggregate lookups (unofficial endpoint; see src/lib/integrations/rmp.ts).
# On by default; set to false as a kill switch. The "View on RMP" link shows either way.
RMP_ENABLED=true

# Encrypts saved Canvas/Blackboard feed URLs. Generate with: openssl rand -base64 32
FEED_ENCRYPTION_KEY=

# Upstash Redis for rate limiting (free tier). Without these, rate limits are skipped (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile CAPTCHA for sign-in (configure the secret in Supabase -> Auth -> Bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
